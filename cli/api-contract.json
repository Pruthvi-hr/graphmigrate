{
  "project": "GraphMigrate",
  "version": "1.0.0",
  "data_disclaimer": "SYNTHETIC PROTOTYPE DATA - ALL HISTORICAL LOGS ARE MOCKED FOR SIMULATION",
  "cli_request_schema": {
    "type": "object",
    "required": ["target_file", "git_commit", "entire_graph_version", "dependency_graph"],
    "properties": {
      "target_file": {
        "type": "string",
        "description": "The file path targeted for refactoring/migration, e.g., 'src/auth/legacy-jwt.js'"
      },
      "git_commit": {
        "type": "string",
        "description": "The current git commit hash for tracking"
      },
      "entire_graph_version": {
        "type": "string",
        "description": "The version of Entire Graph plugin being used"
      },
      "dependency_graph": {
        "type": "object",
        "required": ["nodes", "edges"],
        "properties": {
          "nodes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "type", "lines_of_code"],
              "properties": {
                "id": { "type": "string", "description": "Unique file identifier/path, e.g., 'src/auth/legacy-jwt.js'" },
                "type": { "type": "string", "enum": ["source", "test", "config", "utility"] },
                "lines_of_code": { "type": "integer" }
              }
            }
          },
          "edges": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["source", "target", "type"],
              "properties": {
                "source": { "type": "string", "description": "The file that imports or depends on target" },
                "target": { "type": "string", "description": "The file being imported or depended on" },
                "type": { "type": "string", "enum": ["import", "requires", "calls"] }
              }
            }
          }
        }
      }
    }
  },
  "databricks_response_schema": {
    "type": "object",
    "required": ["target_file", "global_fragility_score", "affected_files_count", "migration_phases", "recommended_tests", "data_label"],
    "properties": {
      "target_file": { "type": "string" },
      "global_fragility_score": { 
        "type": "number", 
        "minimum": 0.0, 
        "maximum": 100.0,
        "description": "Risk index calculated using PageRank centrality * historical CI failures."
      },
      "affected_files_count": { "type": "integer" },
      "data_label": { "type": "string", "description": "Explicit warning that this uses synthetic telemetry" },
      "migration_phases": {
        "type": "array",
        "description": "Sequenced steps for migrating the code to prevent circular or cascading breakages.",
        "items": {
          "type": "object",
          "required": ["phase_number", "phase_name", "files_to_migrate", "risk_level"],
          "properties": {
            "phase_number": { "type": "integer" },
            "phase_name": { "type": "string" },
            "files_to_migrate": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["file_path", "pagerank_score", "historical_failure_rate"],
                "properties": {
                  "file_path": { "type": "string" },
                  "pagerank_score": { "type": "number" },
                  "historical_failure_rate": { "type": "number" }
                }
              }
            },
            "risk_level": { "type": "string", "enum": ["Low", "Medium", "High"] }
          }
        }
      },
      "recommended_tests": {
        "type": "array",
        "description": "The minimal smart subset of tests that cover the affected graph paths.",
        "items": { "type": "string" }
      }
    }
  },
  "mocked_responses": {
    "high_risk_jwt_refactor": {
      "target_file": "src/auth/legacy-jwt.js",
      "global_fragility_score": 84.7,
      "affected_files_count": 8,
      "data_label": "[SYNTHETIC PROTOTYPE TELEMETRY]",
      "migration_phases": [
        {
          "phase_number": 1,
          "phase_name": "Isolate Downstream Leaf Components",
          "files_to_migrate": [
            { "file_path": "src/utils/logger.js", "pagerank_score": 0.12, "historical_failure_rate": 0.05 },
            { "file_path": "src/auth/validators.js", "pagerank_score": 0.28, \"historical_failure_rate\": 0.15 }
          ],
          "risk_level": "Low"
        },
        {
          "phase_number": 2,
          "phase_name": "Update Controllers & Intermediate Layer",
          "files_to_migrate": [
            { "file_path": "src/controllers/user-controller.js", \"pagerank_score\": 0.65, \"historical_failure_rate\": 0.45 },
            { "file_path": "src/controllers/admin-controller.js", \"pagerank_score\": 0.52, \"historical_failure_rate\": 0.30 },
            { "file_path": "src/middleware/auth-middleware.js", \"pagerank_score\": 0.78, \"historical_failure_rate\": 0.60 }
          ],
          "risk_level": "Medium"
        },
        {
          "phase_number": 3,
          "phase_name": "Refactor Core Load-Bearing Identity Module",
          "files_to_migrate": [
            { "file_path": "src/auth/legacy-jwt.js", "pagerank_score": 0.95, "historical_failure_rate": 0.82 }
          ],
          "risk_level": "High"
        }
      ],
      "recommended_tests": [
        "tests/auth/jwt.test.js",
        "tests/middleware/auth.test.js",
        "tests/integration/login.test.js"
      ]
    }
  }
}