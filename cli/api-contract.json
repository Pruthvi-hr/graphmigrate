{
  "project": "GraphMigrate",
  "version": "1.1.0",
  "description": "Strict API contract for JSON communication between the local CLI and Databricks backend - Updated for Track 2 Curveball (Graph as Evidence, Not an Oracle).",
  "cli_request_schema": {
    "type": "object",
    "required": ["target_file", "git_commit", "dependency_graph"],
    "properties": {
      "target_file": {
        "type": "string",
        "description": "The file path targeted for refactoring/migration, e.g., 'src/auth/legacy-jwt.js'"
      },
      "git_commit": {
        "type": "string",
        "description": "The current git commit hash for tracking"
      },
      "entire_graph_version": {
        "type": "string"
      },
      "dependency_graph": {
        "type": "object",
        "required": ["nodes", "edges"],
        "properties": {
          "nodes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "type", "lines_of_code", "evidence_type"],
              "properties": {
                "id": { "type": "string" },
                "type": { "type": "string", "enum": ["source", "test", "config", "utility"] },
                "lines_of_code": { "type": "integer" },
                "evidence_type": { 
                  "type": "string", 
                  "enum": ["confirmed", "heuristic", "unverified"],
                  "description": "confirmed: static AST parse. heuristic: dynamic dispatch/dynamic imports. unverified: dynamic require or code generation"
                }
              }
            }
          },
          "edges": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["source", "target", "type", "evidence_type"],
              "properties": {
                "source": { "type": "string" },
                "target": { "type": "string" },
                "type": { "type": "string", "enum": ["import", "requires", "calls", "dynamic_dispatch", "reflection"] },
                "evidence_type": { "type": "string", "enum": ["confirmed", "heuristic", "unverified"] }
              }
            }
          }
        }
      }
    }
  },
  "databricks_response_schema": {
    "type": "object",
    "required": ["target_file", "global_fragility_score", "affected_files_count", "migration_phases", "recommended_tests", "analysis_completeness"],
    "properties": {
      "target_file": { "type": "string" },
      "global_fragility_score": { "type": "number" },
      "affected_files_count": { "type": "integer" },
      "analysis_completeness": {
        "type": "object",
        "required": ["completeness_percentage", "has_partial_analysis", "unverified_components_count"],
        "properties": {
          "completeness_percentage": { "type": "number" },
          "has_partial_analysis": { "type": "boolean" },
          "unverified_components_count": { "type": "integer" }
        }
      },
      "migration_phases": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["phase_number", "phase_name", "files_to_migrate", "risk_level"],
          "properties": {
            "phase_number": { "type": "integer" },
            "phase_name": { "type": "string" },
            "files_to_migrate": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["file_path", "pagerank_score", "historical_failure_rate", "evidence_type", "verification_required"],
                "properties": {
                  "file_path": { "type": "string" },
                  "pagerank_score": { "type": "number" },
                  "historical_failure_rate": { "type": "number" },
                  "evidence_type": { "type": "string", "enum": ["confirmed", "heuristic", "unverified"] },
                  "verification_required": { "type": "boolean" }
                }
              }
            },
            "risk_level": { "type": "string", "enum": ["Low", "Medium", "High"] }
          }
        }
      },
      "recommended_tests": {
        "type": "array",
        "items": { "type": "string" }
      }
    }
  },
  "mocked_responses": {
    "high_risk_jwt_refactor": {
      "target_file": "src/auth/legacy-jwt.js",
      "global_fragility_score": 92.5,
      "affected_files_count": 9,
      "analysis_completeness": {
        "completeness_percentage": 77.8,
        "has_partial_analysis": true,
        "unverified_components_count": 2
      },
      "migration_phases": [
        {
          "phase_number": 1,
          "phase_name": "Isolate Downstream Leaf Components",
          "files_to_migrate": [
            { "file_path": "src/utils/logger.js", "pagerank_score": 0.12, "historical_failure_rate": 0.05, "evidence_type": "confirmed", "verification_required": false },
            { "file_path": "src/auth/validators.js", "pagerank_score": 0.28, "historical_failure_rate": 0.15, "evidence_type": "confirmed", "verification_required": false }
          ],
          "risk_level": "Low"
        },
        {
          "phase_number": 2,
          "phase_name": "Update Controllers & Intermediate Layer",
          "files_to_migrate": [
            { "file_path": "src/controllers/user-controller.js", "pagerank_score": 0.65, "historical_failure_rate": 0.45, "evidence_type": "confirmed", "verification_required": false },
            { "file_path": "src/controllers/admin-controller.js", "pagerank_score": 0.52, "historical_failure_rate": 0.30, "evidence_type": "confirmed", "verification_required": false },
            { "file_path": "src/middleware/auth-middleware.js", "pagerank_score": 0.78, "historical_failure_rate": 0.60, "evidence_type": "confirmed", "verification_required": false },
            { "file_path": "src/auth/dynamic-dispatcher.js", "pagerank_score": 0.35, "historical_failure_rate": 0.25, "evidence_type": "heuristic", "verification_required": true }
          ],
          "risk_level": "Medium"
        },
        {
          "phase_number": 3,
          "phase_name": "Refactor Core Load-Bearing Identity Module",
          "files_to_migrate": [
            { "file_path": "src/auth/legacy-jwt.js", "pagerank_score": 0.95, "historical_failure_rate": 0.82, "evidence_type": "confirmed", "verification_required": false },
            { "file_path": "src/auth/reflective-loader.js", "pagerank_score": 0.45, "historical_failure_rate": 0.50, "evidence_type": "unverified", "verification_required": true }
          ],
          "risk_level": "High"
        }
      ],
      "recommended_tests": [
        "tests/auth/jwt.test.js",
        "tests/middleware/auth.test.js",
        "tests/integration/login.test.js",
        "tests/fixtures/partial-analysis.test.js"
      ]
    }
  }
}
